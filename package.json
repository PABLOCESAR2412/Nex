    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^26.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "vitest": "^3.2.0",
    "tailwindcss": "^4.3.5",
