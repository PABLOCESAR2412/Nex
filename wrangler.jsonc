{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nex",
  "account_id": "6fcab192a8cc2a3458247ef5c8108a07",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "nex_db",
      "database_name": "nex-db",
      "database_id": "0df29765-c891-4692-b2f1-e3999f645b99"
    }
  ],
  "r2_buckets": [
    {
      "binding": "nex_assets",
      "bucket_name": "nex-assets"
    }
  ],
  "ratelimits": [
    {
      "name": "NEX_OAUTH_REGISTRATION_LIMITER",
      "namespace_id": "951320261115",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
